package:
  name: basic
  version: $version

source:
  url: $source_url
  sha256: $sha256

build:
  number: 0
  noarch: python
  run_exports:
    - {{ pin_subpackage('basic', max_pin='x') }}
  script: "{{ PYTHON }} -m pip install . --no-deps --no-build-isolation --no-cache-dir -vv"
  entry_points:
    - basic-assemble = basic_assembler.cli:main
    - BASIC.py = basic_assembler.cli:main
    - basic-references = basic_assembler.reference_builder:main
    - basic-skill = basic_assembler.skill_cli:main

requirements:
  host:
    - python >=3.10
    - pip
    - setuptools >=77
    - wheel
  run:
    - python >=3.10
    - bowtie2

test:
  imports:
    - basic_assembler
    - basic_assembler.references
  commands:
    - basic-assemble --version
    - BASIC.py --help
    - basic-references --help
    - basic-skill --print > /dev/null
    - bowtie2 --version

about:
  home: https://github.com/akds/BASIC
  dev_url: https://github.com/akds/BASIC
  license: $license_expression
  license_file: $license_file
  summary: BCR and TCR assembly from single-cell RNA-seq

extra:
  notes: >-
    IgBLAST and its germline databases are optional and installed separately.
